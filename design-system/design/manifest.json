{
  "schemaVersion": 5,
  "kind": "project-design-system",
  "entry": "index.html",
  "canonical": {
    "file": "design-system.json"
  },
  "aiInstructions": "AI.md",
  "connectionInstructions": "CONNECT.md",
  "runtime": {
    "file": "server.mjs",
    "command": "node design-system/design/server.mjs",
    "mountExport": "createDesignSystemHandler",
    "scope": "this-project-only",
    "writes": [
      "design-system.json",
      "editor-link.js",
      "DESIGN.md",
      "preview-data.js"
    ],
    "localEntry": "editor-link.js"
  },
  "api": {
    "relativeBase": "api/design-system",
    "read": "GET",
    "write": "PUT",
    "precondition": "baseRevision and file from latest GET",
    "applicationReport": "POST api/design-system/applied"
  },
  "projectMappings": {
    "file": "design-system.json",
    "field": "definitions.*.mapping"
  },
  "catalogs": {
    "guidelines": "guidelines/README.md",
    "components": "components/README.md"
  },
  "template": "template.json",
  "workflows": {
    "setup": "CONNECT.md",
    "refresh": "AI.md",
    "apply": "AI.md"
  },
  "desktop": {
    "windows": "../Momo Design System.exe",
    "settings": ".desktop-settings.json",
    "scope": "one-project-per-instance",
    "runtime": ".desktop-runtime.json",
    "port": "automatic-by-default"
  },
  "derived": {
    "editable": false,
    "source": "design-system.json",
    "file": "DESIGN.md"
  }
}
