<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../StatusMonitor/Services/AlertEngine.cs" Link="AlertEngine.cs" />
    <Compile Include="../../../StatusMonitor/Services/TelemetryHistory.cs" Link="TelemetryHistory.cs" />
    <Compile Include="../../../StatusMonitor/Services/GpuSelection.cs" Link="GpuSelection.cs" />
    <Compile Include="../../../StatusMonitor/Models/Snapshot.cs" Link="Snapshot.cs" />
    <Compile Include="../../../StatusMonitor/Settings/AppSettings.cs" Link="AppSettings.cs" />
    <!-- AppSettings.EnergyPeriod lives here, so the settings type no longer compiles without it. -->
    <Compile Include="../../../StatusMonitor/Services/EnergyHistory.cs" Link="EnergyHistory.cs" />
    <!-- Fan curve maths is deliberately free of any hardware type, so it is testable here.
         The service that writes to the hardware is not, and is not linked in. -->
    <Compile Include="../../../StatusMonitor/Models/FanCurve.cs" Link="FanCurve.cs" />
    <!-- Which header is which is decided from its name alone, and this machine has no
         motherboard fans to try it on, so the rules are checked here against a real board's. -->
    <Compile Include="../../../StatusMonitor/Models/FanNaming.cs" Link="FanNaming.cs" />
    <!-- The rule that decides whether a remembered window position is still on a screen.
         It has to hold for monitor layouts this machine does not have. -->
    <Compile Include="../../../StatusMonitor/Models/WindowPlacement.cs" Link="WindowPlacement.cs" />
    <!-- The wattage curves. They decide the hero figure, the running total, the carbon figure
         and the cost, and they are pure arithmetic, so they belong under test. -->
    <Compile Include="../../../StatusMonitor/Power/PowerModel.cs" Link="PowerModel.cs" />
    <!-- The box the owner types a board power into. It guards the one figure nothing else on
         the machine can supply, so what it accepts and rejects is worth pinning. -->
    <Compile Include="../../../StatusMonitor/ViewModels/GpuTdpVm.cs" Link="GpuTdpVm.cs" />
  </ItemGroup>
</Project>
