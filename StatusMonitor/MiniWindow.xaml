<Window x:Class="StatusMonitor.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:StatusMonitor.I18n"
        Title="{Binding Source={x:Static i18n:Loc.Instance}, Path=[app_title]}"
        Width="278" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}" FontSize="12"
        Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <!-- Glanceable readout, not a shrunken dashboard: the icon names the metric, the number
             gives the reading. Bars are dropped — they earn their place only where there is room
             to compare their lengths against each other. -->
        <Style x:Key="MiniValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <!-- Keeps each icon glued to its own number while the numbers still line up. -->
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style x:Key="MiniIcon" TargetType="Path" BasedOn="{StaticResource RowIcon}">
            <Setter Property="StrokeThickness" Value="2.2" />
        </Style>
        <Style x:Key="MiniIconTop" TargetType="Path" BasedOn="{StaticResource RowIconTop}">
            <Setter Property="StrokeThickness" Value="2.2" />
        </Style>
        <Style x:Key="MiniCell" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,4,8" />
        </Style>
        <!-- Separation without an outline. A hard ink border read as a black box on the light
             skin and a white one on the dark; the panel now floats on a shadow with the app's
             own hairline, which is a low-contrast step off the panel rather than a frame. -->
        <DropShadowEffect x:Key="MiniShadow" BlurRadius="16" ShadowDepth="3" Direction="270"
                          Color="#000000" Opacity="0.30" />
        <!-- Quiet, like the header icons in the main window: a filled square in the corner of a
             panel this small is the loudest thing on it, and neither of these is the point. -->
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- The whole panel drags; DragMini skips buttons and the pin box. -->
    <!-- Margin, not padding: the shadow needs room inside the window to render, which is why
         the window is 278 wide for a 258 panel. -->
    <Border Background="{DynamicResource PopPaper}" BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" CornerRadius="8"
            Margin="10" Effect="{StaticResource MiniShadow}"
            Padding="11,6,11,8" MouseLeftButtonDown="DragMini" Cursor="SizeAll"
            ToolTip="{Binding Source={x:Static i18n:Loc.Instance}, Path=[drag_hint]}">
        <Grid>
            <!-- Every row is Auto and the window is SizeToContent: a star row left slack under
                 the readings that read as dead space. No grip either — the whole panel drags,
                 so a handle only advertised something that is true everywhere. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Power, the one figure kept at any size. -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalWattsValue}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="28" FontWeight="Black" FontStyle="Italic"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="W" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold"
                               FontStyle="Italic" VerticalAlignment="Bottom" Margin="3,0,0,4"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="↗" Style="{StaticResource MiniIconButton}" Click="RestoreMain"
                            ToolTip="{Binding Source={x:Static i18n:Loc.Instance}, Path=[restore]}" />
                    <!-- Same meaning as the main window's close button, deliberately: it ends the
                         program, or hides to the tray when that is switched on. A second, different
                         sense of "close" living only in the mini panel would be a trap. -->
                    <Button x:Name="MiniCloseButton" Content="✕" Style="{StaticResource MiniIconButton}" Click="CloseFromMini" Margin="2,0,0,0"
                            ToolTip="{Binding Source={x:Static i18n:Loc.Instance}, Path=[close]}" />
                </StackPanel>
            </Grid>

            <!-- Totals on one quiet line; they move slowly and never need to shout. -->
            <TextBlock Grid.Row="1" Style="{StaticResource RowSub}" Margin="0,0,0,8">
                <Run Text="{Binding EnergyText, Mode=OneWay}"/><Run Text="  ·  "/><Run
                    Text="{Binding CarbonText, Mode=OneWay}"/><Run Text="  ·  "/><Run
                    Text="{Binding CostText, Mode=OneWay}"/>
            </TextBlock>

            <!-- Two columns of icon + value. A collapsed GPU slot reflows on its own. -->
            <UniformGrid Grid.Row="2" Columns="2" VerticalAlignment="Top">
                <StackPanel Style="{StaticResource MiniCell}">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" ToolTip="CPU"><Grid Width="24" Height="24"><Path Style="{StaticResource MiniIcon}" Data="{StaticResource IcoCpu}" /><Path Style="{StaticResource MiniIconTop}" Data="{StaticResource IcoCpuTop}" /></Grid></Viewbox>
                    <TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource MiniValue}"
                               Foreground="{Binding CpuTone, Converter={StaticResource ToneBrush}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource MiniCell}">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" ToolTip="RAM"><Grid Width="24" Height="24"><Path Style="{StaticResource MiniIcon}" Data="{StaticResource IcoRam}" /><Path Style="{StaticResource MiniIconTop}" Data="{StaticResource IcoRamTop}" /></Grid></Viewbox>
                    <TextBlock Text="{Binding RamLoadText}" Style="{StaticResource MiniValue}"
                               Foreground="{Binding RamTone, Converter={StaticResource ToneBrush}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource MiniCell}" Visibility="{Binding Gpu1Visible, Converter={StaticResource BoolToVisibility}}">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" ToolTip="{Binding GpuCard1.Name}"><Grid Width="24" Height="24"><Path Style="{StaticResource MiniIcon}" Data="{StaticResource IcoGpu}" /><Path Style="{StaticResource MiniIconTop}" Data="{StaticResource IcoGpuTop}" /></Grid></Viewbox>
                    <TextBlock Text="{Binding GpuCard1.LoadText}" Style="{StaticResource MiniValue}"
                               Foreground="{Binding GpuCard1.Tone, Converter={StaticResource ToneBrush}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource MiniCell}">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static i18n:Loc.Instance}, Path=[info_storage]}"><Grid Width="24" Height="24"><Path Style="{StaticResource MiniIcon}" Data="{StaticResource IcoDisk}" /><Path Style="{StaticResource MiniIconTop}" Data="{StaticResource IcoDiskTop}" /></Grid></Viewbox>
                    <TextBlock Text="{Binding DiskPeakText}" Style="{StaticResource MiniValue}" FontSize="18"
                               Foreground="{Binding DiskPeakTone, Converter={StaticResource ToneBrush}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource MiniCell}" Visibility="{Binding Gpu2Visible, Converter={StaticResource BoolToVisibility}}">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" ToolTip="{Binding GpuCard2.Name}"><Grid Width="24" Height="24"><Path Style="{StaticResource MiniIcon}" Data="{StaticResource IcoGpu}" /><Path Style="{StaticResource MiniIconTop}" Data="{StaticResource IcoGpuTop}" /></Grid></Viewbox>
                    <TextBlock Text="{Binding GpuCard2.LoadText}" Style="{StaticResource MiniValue}"
                               Foreground="{Binding GpuCard2.Tone, Converter={StaticResource ToneBrush}}"/>
                </StackPanel>
                <StackPanel Style="{StaticResource MiniCell}">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static i18n:Loc.Instance}, Path=[network]}"><Grid Width="24" Height="24"><Path Style="{StaticResource MiniIcon}" Data="{StaticResource IcoNet}" /><Path Style="{StaticResource MiniIconTop}" Data="{StaticResource IcoNetTop}" /></Grid></Viewbox>
                    <StackPanel VerticalAlignment="Center" MinWidth="54" Margin="5,0,0,0">
                        <TextBlock Text="{Binding NetDownText}" Style="{StaticResource RowSub}" Margin="0" TextAlignment="Right"/>
                        <TextBlock Text="{Binding NetUpText}" Style="{StaticResource RowSub}" Margin="0,1,0,0" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>

            <!-- "Always on top" moved into Settings: it is set once and then never touched, so
                 it was spending a permanent line of a panel that has no room to spare. -->
            <Grid Grid.Row="3" Margin="0,2,0,0">
                <TextBlock Text="{Binding ReadingStatus}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
