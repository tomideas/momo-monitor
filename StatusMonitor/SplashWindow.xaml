<Window x:Class="StatusMonitor.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:StatusMonitor.I18n"
        Title="{Binding Source={x:Static i18n:Loc.Instance}, Path=[app_title]}"
        Width="484" Height="284" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}" Foreground="{DynamicResource InkBrush}" FontSize="12">
  <!-- Opening the hardware hub takes a second or more; the window used to sit there blank
       and unresponsive while it happened. This covers that wait with the brand instead of
       with nothing, and the sensors now warm up off the UI thread so the bar actually moves. -->
  <!-- No outline, for the same reason the mini panel lost its own: a 2 DIP Ink frame read as a
       white box on the dark skin and a black one on the light. A shadow with the app's own
       hairline lets it sit on the desktop instead of being boxed off from it. The 12 DIP margin
       is the room the shadow needs to draw, which is why the window is 484 for a 460 panel. -->
  <Border Background="{DynamicResource PopPaper}" BorderBrush="{DynamicResource HairBrush}" BorderThickness="1"
          Margin="12" CornerRadius="12" Padding="38,34,38,30">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.34" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The same lockup as the Settings footer, scaled up: mark, name, version. A splash is
           where identity is the whole point, so the mark leads at 72 DIP rather than sitting
           beside the text as a 34 DIP caption. -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Assets/momo.png" Width="72" Height="72"
               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock Text="Momo" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="Black"
                     FontStyle="Italic" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,-4" />
          <!-- The name is split, not repeated: "Momo" carries the brand in the display face,
               the descriptor sits under it at label weight. Printing app_brand here would
               have put "Momo" on the page twice. -->
          <TextBlock Text="{Binding Source={x:Static i18n:Loc.Instance}, Path=[app_descriptor]}"
                     FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- Indeterminate by design: the work behind it is one opaque driver call, so a
           percentage would be invented. The block sweeps; it never claims a position. -->
      <Border Grid.Row="1" x:Name="Track" Width="240" Height="10" HorizontalAlignment="Center"
              Background="{DynamicResource TrackBrush}"
              Margin="0,0,0,16" ClipToBounds="True" SnapsToDevicePixels="True">
        <Rectangle x:Name="Pip" Width="64" HorizontalAlignment="Left" Fill="{DynamicResource AccentBrush}">
          <Rectangle.RenderTransform>
            <TranslateTransform x:Name="PipShift" />
          </Rectangle.RenderTransform>
        </Rectangle>
      </Border>

      <TextBlock Grid.Row="2" x:Name="StatusText" HorizontalAlignment="Center"
                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                 Foreground="{DynamicResource MutedBrush}"
                 Text="{Binding Source={x:Static i18n:Loc.Instance}, Path=[splash_loading]}" />
    </Grid>
  </Border>
</Window>
